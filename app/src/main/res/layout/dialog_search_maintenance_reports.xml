<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <TextView
        android:id="@+id/text_modal_search_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/maintenance_search_modal_title"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textColor="@color/maint_text_primary" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_modal_report_search"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/report_search_hint"
        app:boxStrokeColor="@color/maint_outline"
        app:hintTextColor="@color/maint_text_secondary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_modal_report_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:textColor="@color/maint_text_primary"
            android:textColorHint="@color/maint_text_secondary" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/text_modal_search_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingVertical="8dp"
        android:text="@string/report_no_events"
        android:textColor="@color/maint_text_secondary"
        android:textSize="15sp"
        android:visibility="gone"
        tools:visibility="visible" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_modal_report_search"
        android:layout_width="match_parent"
        android:layout_height="420dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:overScrollMode="ifContentScrolls"
        tools:listitem="@layout/item_maintenance_event" />
</LinearLayout>
