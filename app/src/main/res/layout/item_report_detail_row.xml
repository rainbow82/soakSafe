<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <View
        android:id="@+id/view_row_accent"
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_report_accent_task" />

    <TextView
        android:id="@+id/text_row_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/bg_report_label_chip"
        android:paddingStart="12dp"
        android:paddingTop="7dp"
        android:paddingEnd="12dp"
        android:paddingBottom="7dp"
        android:textAppearance="@style/TextAppearance.SoakSafe.ReportRowLabel"
        tools:text="Vacuum" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/image_row_check"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_report_check_circle"
        android:contentDescription="@string/report_task_done_content_description"
        android:padding="4dp"
        android:visibility="gone"
        app:srcCompat="@drawable/ic_check_24"
        app:tint="@color/report_check_green"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/text_row_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_report_value_chip"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:textAppearance="@style/TextAppearance.SoakSafe.ReportRowValue"
        android:visibility="gone"
        tools:text="2.50"
        tools:visibility="visible" />
</LinearLayout>
