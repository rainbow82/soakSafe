<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MaintenanceDetailsActivity">

    <include layout="@layout/include_pool_photo_background" />

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/maint_surface"
            android:elevation="0dp"
            app:liftOnScroll="false">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:navigationIcon="@drawable/ic_menu_hamburger_24"
                app:title="@string/maintenance_details_title"
                app:titleCentered="true"
                app:titleTextAppearance="@style/TextAppearance.SoakSafe.ToolbarTitle"
                app:titleTextColor="@color/maint_text_primary" />
        </com.google.android.material.appbar.AppBarLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_maintenance"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/maintenance_scroll_bottom_padding"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="4dp">

                <TextView
                    android:id="@+id/text_maintenance_date_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingVertical="8dp"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="@android:color/white"
                    android:textSize="17sp"
                    tools:text="05/05/2026" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="@color/maint_surface"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/maint_outline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:id="@+id/container_maintenance_chips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:divider="@drawable/bg_maintenance_chips_row_divider"
                        android:orientation="vertical"
                        android:showDividers="middle" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_save_maintenance"
                    style="@style/Widget.Material3.Button.UnelevatedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="12dp"
                    android:text="@string/save_maintenance"
                    android:textColor="@color/maint_save_button_text"
                    app:backgroundTint="@color/maint_save_button"
                    app:rippleColor="#660A1628" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/bottom_action_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/maint_bottom_bar_bg"
            android:elevation="0dp"
            android:gravity="center_vertical"
            android:minHeight="@dimen/maintenance_bottom_bar_height"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/button_bottom_search"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/bottom_bar_search"
                android:padding="12dp"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/ic_search_outline_24" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/button_bottom_document"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/bottom_bar_document"
                android:padding="12dp"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/ic_document_outline_24" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/button_bottom_pdf"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/bottom_bar_pdf"
                android:padding="12dp"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/ic_share_nodes_outline_24" />
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_add_custom_item"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="0dp"
            android:contentDescription="@string/fab_add_custom_maintenance_item_content_description"
            android:elevation="12dp"
            android:translationZ="12dp"
            app:backgroundTint="@color/maint_save_button"
            app:borderWidth="0dp"
            app:elevation="12dp"
            app:srcCompat="@drawable/ic_add_24"
            app:tint="@color/maint_save_button_text"
            app:useCompatPadding="false" />
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</FrameLayout>
