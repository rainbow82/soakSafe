<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/maint_background"
    tools:context=".MaintenanceDetailsActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/maint_background"
        android:elevation="0dp"
        app:liftOnScroll="false">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_menu_hamburger_24"
            app:title="@string/maintenance_details_title"
            app:titleCentered="true"
            app:titleTextAppearance="@style/TextAppearance.SoakSafe.ToolbarTitle"
            app:titleTextColor="@color/maint_text_primary" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_maintenance"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/maintenance_scroll_bottom_padding"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="4dp">

            <TextView
                android:id="@+id/text_maintenance_date_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingVertical="8dp"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="@android:color/white"
                android:textSize="17sp"
                tools:text="05/05/2026" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/maint_surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/maint_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/section_tasks"
                        android:textAppearance="@style/TextAppearance.SoakSafe.SectionLabel"
                        android:textColor="@color/maint_text_primary" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/checkbox_vacuum"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/task_vacuum"
                        android:textColor="@color/maint_text_primary"
                        app:buttonTint="@color/task_checkbox_tint" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/checkbox_clean_skimmer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/task_clean_skimmer"
                        android:textColor="@color/maint_text_primary"
                        app:buttonTint="@color/task_checkbox_tint" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/checkbox_add_water"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/task_add_water"
                        android:textColor="@color/maint_text_primary"
                        app:buttonTint="@color/task_checkbox_tint" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/checkbox_brush_walls"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/task_brush_walls"
                        android:textColor="@color/maint_text_primary"
                        app:buttonTint="@color/task_checkbox_tint" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/maint_surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/maint_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/section_chemicals"
                        android:textAppearance="@style/TextAppearance.SoakSafe.SectionLabel"
                        android:textColor="@color/maint_text_primary" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/input_layout_chlorine"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/chemical_chlorine">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edit_chlorine"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal|numberSigned"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/input_layout_ph_up"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="@string/chemical_ph_up">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edit_ph_up"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal|numberSigned"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/input_layout_ph_down"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="@string/chemical_ph_down">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edit_ph_down"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal|numberSigned"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/input_layout_no_phos"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="@string/chemical_no_phos">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edit_no_phos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal|numberSigned"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_save_chemicals"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/save_chemicals" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/bottom_action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/maint_bottom_bar_bg"
        android:elevation="10dp"
        android:gravity="center_vertical"
        android:minHeight="@dimen/maintenance_bottom_bar_height"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/button_bottom_search"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/bottom_bar_search"
            android:padding="12dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/ic_search_outline_24" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/button_bottom_share"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/bottom_bar_share"
            android:padding="12dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/ic_share_nodes_outline_24" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/button_bottom_document"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/bottom_bar_document"
            android:padding="12dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/ic_document_outline_24" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
