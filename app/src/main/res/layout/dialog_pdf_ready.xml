<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/dialog_surface"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/text_pdf_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pdf_export_ready_title"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="@color/maint_text_primary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_pdf_share"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/pdf_action_share" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_pdf_save"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/pdf_action_save"
        android:textColor="@color/maint_text_primary"
        app:strokeColor="@color/home_input_outline" />
</LinearLayout>
