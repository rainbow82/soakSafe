<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/dialog_surface"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/text_delete_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/delete_report"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="@color/maint_text_primary" />

    <TextView
        android:id="@+id/text_delete_dialog_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/delete_report_confirm"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="@color/maint_text_primary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_delete_cancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@android:string/cancel"
            android:textColor="@color/home_form_on_surface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_delete_confirm"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/delete_report_button"
            android:textColor="@color/home_primary" />
    </LinearLayout>
</LinearLayout>
