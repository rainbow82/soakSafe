<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.SoakSafe.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.SoakSafe.CardTitle" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/maint_text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.SoakSafe.SectionLabel" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/maint_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.SoakSafe.ReportCardTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/report_text_dark</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">17sp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.SoakSafe.ReportCardSubtitle" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/report_text_secondary_dark</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.SoakSafe.ReportRowLabel" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/report_text_dark</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.SoakSafe.ReportRowValue" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/report_text_dark</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="ShapeAppearanceOverlay.SoakSafe.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Widget.SoakSafe.SaveButton" parent="Widget.Material3.Button.UnelevatedButton">
        <item name="backgroundTint">@color/maint_save_button</item>
        <item name="android:textColor">@color/maint_save_button_text</item>
        <item name="rippleColor">#660A1628</item>
    </style>

    <style name="Widget.SoakSafe.AddFab" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/maint_save_button</item>
        <item name="tint">@color/maint_save_button_text</item>
    </style>

    <!-- Dark label on frosted cards; blue stroke unchanged (passes WCAG AA on composited glass) -->
    <style name="Widget.SoakSafe.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/soaksafe_outlined_button_text</item>
        <item name="iconTint">@color/home_form_on_surface</item>
        <item name="strokeColor">@color/home_primary</item>
    </style>

    <!-- Selected: green fill + dark text; unselected: dark text + blue outline -->
    <style name="Widget.SoakSafe.OutlinedToggleButton" parent="Widget.SoakSafe.OutlinedButton">
        <item name="android:textColor">@color/soaksafe_toggle_button_text</item>
        <item name="backgroundTint">@color/soaksafe_toggle_button_background</item>
        <item name="strokeColor">@color/soaksafe_toggle_button_stroke</item>
    </style>
</resources>
