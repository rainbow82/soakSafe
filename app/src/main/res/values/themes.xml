<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SoakSafe" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/pool_accent</item>
        <item name="colorPrimaryContainer">@color/pool_accent_variant</item>
        <item name="colorOnPrimary">@color/on_pool_accent</item>
        <!-- Same blue wash as Maintenance Details -->
        <item name="android:windowBackground">@color/maint_background</item>
        <item name="android:colorBackground">@color/maint_background</item>
        <item name="colorSurface">@color/maint_background</item>
        <item name="colorSurfaceDim">@color/maint_background</item>
        <item name="colorSurfaceBright">@color/maint_background</item>
        <item name="colorSurfaceContainerLowest">@color/maint_background</item>
        <item name="colorSurfaceContainerLow">@color/maint_background</item>
        <item name="colorSurfaceContainer">@color/maint_background</item>
        <item name="colorSurfaceContainerHigh">@color/maint_background</item>
        <item name="colorSurfaceContainerHighest">@color/maint_background</item>
        <item name="android:statusBarColor">@color/maint_background</item>
        <item name="android:navigationBarColor">@color/maint_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Home (sign-in): pool photo behind transparent window; form uses light surfaces -->
    <style name="Theme.SoakSafe.Home" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/home_primary</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorPrimaryContainer">@color/pool_accent_variant</item>
        <item name="colorOnPrimaryContainer">@color/home_form_on_surface</item>
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="colorSurface">@color/frosted_surface</item>
        <item name="colorSurfaceDim">@color/frosted_surface</item>
        <item name="colorSurfaceBright">@color/frosted_surface_high</item>
        <item name="colorSurfaceContainerLowest">@android:color/transparent</item>
        <item name="colorSurfaceContainerLow">@color/frosted_surface</item>
        <item name="colorSurfaceContainer">@color/frosted_surface</item>
        <item name="colorSurfaceContainerHigh">@color/frosted_surface_high</item>
        <item name="colorSurfaceContainerHighest">@color/frosted_surface_high</item>
        <item name="colorOutlineVariant">@color/frosted_divider</item>
        <item name="colorOnSurface">@color/home_form_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/home_form_on_surface_variant</item>
        <item name="colorOutline">@color/home_input_outline</item>
        <item name="android:statusBarColor">@color/home_status_bar</item>
        <item name="android:navigationBarColor">@color/home_nav_bar</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Create account: water gradient in layout; form uses same light surfaces as Home -->
    <style name="Theme.SoakSafe.CreateAccount" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/home_primary</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorPrimaryContainer">@color/pool_accent_variant</item>
        <item name="colorOnPrimaryContainer">@color/home_form_on_surface</item>
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="colorSurface">@color/frosted_surface</item>
        <item name="colorSurfaceDim">@color/frosted_surface</item>
        <item name="colorSurfaceBright">@color/frosted_surface_high</item>
        <item name="colorSurfaceContainerLowest">@android:color/transparent</item>
        <item name="colorSurfaceContainerLow">@color/frosted_surface</item>
        <item name="colorSurfaceContainer">@color/frosted_surface</item>
        <item name="colorSurfaceContainerHigh">@color/frosted_surface_high</item>
        <item name="colorSurfaceContainerHighest">@color/frosted_surface_high</item>
        <item name="colorOutlineVariant">@color/frosted_divider</item>
        <item name="colorOnSurface">@color/home_form_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/home_form_on_surface_variant</item>
        <item name="colorOutline">@color/home_input_outline</item>
        <item name="android:statusBarColor">@color/home_status_bar</item>
        <item name="android:navigationBarColor">@color/create_account_water_nav</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Maintenance flows: pool photo in layout; theme window is transparent over it -->
    <style name="Theme.SoakSafe.Maintenance" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/maint_fab</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorOnSurface">@color/maint_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/maint_text_secondary</item>
        <item name="colorSurface">@color/frosted_surface</item>
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="colorSurfaceContainerLowest">@android:color/transparent</item>
        <item name="colorSurfaceContainerLow">@color/frosted_surface</item>
        <item name="colorSurfaceContainer">@color/frosted_surface</item>
        <item name="colorSurfaceContainerHigh">@color/frosted_surface_high</item>
        <item name="colorSurfaceContainerHighest">@color/frosted_surface_high</item>
        <item name="colorOutline">@color/frosted_outline</item>
        <item name="colorOutlineVariant">@color/frosted_divider</item>
        <item name="android:statusBarColor">@color/home_status_bar</item>
        <item name="android:navigationBarColor">@color/maint_bottom_bar_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Opaque alert dialogs over pool-photo screens (Maintenance theme window is transparent) -->
    <style name="ThemeOverlay.SoakSafe.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@color/dialog_surface</item>
        <item name="android:colorBackground">@color/dialog_surface</item>
        <item name="colorSurface">@color/dialog_surface</item>
        <item name="colorOnSurface">@color/maint_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/maint_text_secondary</item>
        <item name="android:textColorPrimary">@color/maint_text_primary</item>
        <item name="android:textColorSecondary">@color/maint_text_secondary</item>
    </style>
</resources>
